# Copy this file to .env for local development. Never commit .env or secrets.

DEV_PROVIDER=openrouter
DEV_BASE_URL=https://openrouter.ai/api/v1
DEV_API_KEY=sk-or-v1-replace-with-your-openrouter-key
DEV_MODEL=poolside/laguna-s-2.1:free
# Safety and execution limits
DEV_APPROVAL_REQUIRED=true
DEV_MAX_ITERATIONS=8
DEV_MAX_TOOL_CALLS=40
DEV_COMMAND_TIMEOUT=120
DEV_TEST_COMMAND=
DEV_MAX_FILE_BYTES=1000000

# Optional local semantic optimization
DEV_EMBEDDINGS_ENABLED=false
DEV_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
DEV_EMBEDDING_CACHE_DIR=~/.cache/dev/embeddings
DEV_EMBEDDINGS_OFFLINE=false

# Optional tracing
LANGSMITH_TRACING=false
